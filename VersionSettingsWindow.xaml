<ui:FluentWindow x:Class="CatMin.VersionSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="版本设置" Height="450" Width="600"
        WindowBackdropType="Mica" ExtendsContentIntoTitleBar="True">
    
    <Grid Margin="30">
        <StackPanel>
            <TextBlock x:Name="TitleText" Text="版本设置" FontSize="24" FontWeight="Bold" Margin="0,0,0,20"/>
            
            <ui:Card Padding="20" Margin="0,0,0,20">
                <StackPanel Orientation="Horizontal">
                    <Image x:Name="VersionIcon" Width="48" Height="48" Margin="0,0,20,0"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="VersionNameText" FontSize="20" FontWeight="Bold"/>
                        <TextBlock x:Name="VersionTypeText" FontSize="14" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,5,0,0"/>
                    </StackPanel>
                </StackPanel>
            </ui:Card>

            <TextBlock Text="快捷方式" FontSize="16" FontWeight="Bold" Margin="0,10,0,10"/>
            <StackPanel Orientation="Horizontal">
                <ui:Button Content="打开版本文件夹" Width="150" Height="40" Margin="0,0,10,0" Click="OpenFolder_Click"/>
            </StackPanel>

            <TextBlock Text="高级管理" FontSize="16" FontWeight="Bold" Margin="0,30,0,10"/>
            <ui:Button Content="删除此版本" Appearance="Danger" Width="150" Height="40" HorizontalAlignment="Left" Click="Delete_Click"/>
        </StackPanel>
    </Grid>
</ui:FluentWindow>