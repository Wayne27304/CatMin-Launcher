<ui:FluentWindow x:Class="CatMin.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="CatMin Launcher" Height="800" Width="1280"
        WindowBackdropType="Mica" ExtendsContentIntoTitleBar="True"
        AllowDrop="True" Drop="Window_Drop" DragOver="Window_DragOver">
    
    <Window.Resources>
        <Storyboard x:Key="PageTransition">
            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.2"/>
            <ThicknessAnimation Storyboard.TargetProperty="Margin" From="0,10,0,-10" To="0,0,0,0" Duration="0:0:0.2">
                <ThicknessAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></ThicknessAnimation.EasingFunction>
            </ThicknessAnimation>
        </Storyboard>

        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="15,12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}" Margin="0,2">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#22FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Background="#1A1A1A">
        <Border x:Name="BackgroundWallpaper" Grid.ColumnSpan="2" Grid.RowSpan="3" Opacity="0.8">
            <Border.Background>
                <ImageBrush x:Name="BgImageBrush" Stretch="UniformToFill" Opacity="0.6"/>
            </Border.Background>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 左側導航 -->
            <Border Grid.Column="0" Background="#EE111111" BorderBrush="#333" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="60"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                        <TextBlock Text="CatMin" FontSize="22" FontWeight="Black" VerticalAlignment="Center" Margin="20,0,0,0" Foreground="#0078D7"/>
                    </Grid>
                    
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Hidden">
                        <StackPanel Margin="10,10,10,0">
                            <ui:Button Content="启动游戏" Icon="{ui:SymbolIcon Play24}" Style="{StaticResource NavButton}" Click="ShowHome_Click"/>
                            <ui:Button Content="版本管理" Icon="{ui:SymbolIcon BoxMultiple24}" Style="{StaticResource NavButton}" Click="ShowVersionManager_Click"/>
                            <ui:Button Content="下载中心" Icon="{ui:SymbolIcon ArrowDownload24}" Style="{StaticResource NavButton}" Click="ShowDownloadPage"/>
                            <ui:Button Content="Mod 管理" Icon="{ui:SymbolIcon PuzzlePiece24}" Style="{StaticResource NavButton}" Click="ShowModManagerPage"/>
                            <ui:Button Content="Mod 搜索" Icon="{ui:SymbolIcon Search24}" Style="{StaticResource NavButton}" Click="ShowModSearchPage"/>
                            <ui:Button Content="服务器状态" Icon="{ui:SymbolIcon Server24}" Style="{StaticResource NavButton}" Click="ShowServerPanel"/>
                            <ui:Button Content="账号管理" Icon="{ui:SymbolIcon Person24}" Style="{StaticResource NavButton}" Click="ShowAccountPage"/>
                            <ui:Button Content="游戏日志" Icon="{ui:SymbolIcon DocumentText24}" Style="{StaticResource NavButton}" Click="ShowLogPanel"/>
                            <ui:Button Content="高级设置" Icon="{ui:SymbolIcon Settings24}" Style="{StaticResource NavButton}" Click="ShowSettings_Click"/>
                        </StackPanel>
                    </ScrollViewer>
                    
                    <Border Grid.Row="2" Padding="15" Background="#33222222" Margin="10">
                        <StackPanel>
                            <TextBlock Text="系统内存信息" FontSize="11" Foreground="Gray"/>
                            <TextBlock x:Name="MemoryInfoText" Text="加载中..." FontSize="12" Foreground="White"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- 右側主內容 -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="60"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="40"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,15,0">
                        <ui:Button Icon="{ui:SymbolIcon Subtract24}" Appearance="Transparent" Width="46" Height="32" Click="Minimize_Click"/>
                        <ui:Button Icon="{ui:SymbolIcon Dismiss24}" Appearance="Transparent" Width="46" Height="32" Click="Close_Click"/>
                    </StackPanel>
                </Grid>

                <!-- 頁面容器 -->
                <Grid Grid.Row="1" Margin="40,20,40,20">
                    
                    <!-- 0. 啟動中頁面 -->
                    <Grid x:Name="LaunchingPanel" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="360"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- 左側狀態區 -->
                        <Border Grid.Column="0" Background="#EE1E1E1E" CornerRadius="10" Padding="30" Margin="0,0,20,0">
                            <StackPanel VerticalAlignment="Center">
                                <!-- 修正圖示名稱 -->
                                <ui:SymbolIcon Symbol="Play24" FontSize="64" Foreground="#3B82F6" HorizontalAlignment="Center" Margin="0,0,0,20"/>
                                <TextBlock x:Name="LaunchTitleText" Text="正在启动游戏" FontSize="24" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                                <TextBlock x:Name="LaunchVersionText" Text="1.20.1" FontSize="14" Foreground="#AAA" HorizontalAlignment="Center" Margin="0,5,0,30"/>
                                
                                <ProgressBar x:Name="LaunchProgressBar" Height="6" Width="260" Minimum="0" Maximum="100" Value="0" Margin="0,0,0,20" Background="#333" Foreground="#3B82F6"/>
                                
                                <Grid Width="260" Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="当前步骤:" Foreground="#AAA" FontSize="13"/>
                                    <TextBlock x:Name="CurrentStepText" Text="准备中..." Foreground="White" FontSize="13" Grid.Column="1" HorizontalAlignment="Right"/>
                                </Grid>
                                <Grid Width="260" Margin="0,0,0,40">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="登录方式:" Foreground="#AAA" FontSize="13"/>
                                    <TextBlock x:Name="LoginTypeText" Text="离线" Foreground="White" FontSize="13" Grid.Column="1" HorizontalAlignment="Right"/>
                                </Grid>

                                <ui:Button Content="返回主页 (游戏将继续运行)" Width="260" Height="40" Click="CancelLaunch_Click"/>
                            </StackPanel>
                        </Border>

                        <!-- 右側冷知識區 -->
                        <ui:Card Grid.Column="1" Background="#EE222222" Padding="25">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="你知道吗？ (Minecraft 冷知识)" FontSize="18" FontWeight="Bold" Foreground="White" Margin="0,0,0,15"/>
                                <ScrollViewer Grid.Row="1">
                                    <StackPanel>
                                        <TextBlock Text="💡 1.20 版本后，Minecraft 的启动需要 Java 17 或更高版本，如果启动失败请检查 Java 版本。" Foreground="#AAA" TextWrapping="Wrap" Margin="0,0,0,15"/>
                                        <TextBlock Text="❄️ 细雪（Powder Snow）可以让你陷入其中，穿上皮革靴子可以防止下陷并安全走上细雪。" Foreground="#AAA" TextWrapping="Wrap" Margin="0,0,0,15"/>
                                        <TextBlock Text="⚔️ 在 1.16 版本中，猪灵会主动攻击没有穿金装备的玩家，但如果你把金装备丢给它们，它们会放过你。" Foreground="#AAA" TextWrapping="Wrap" Margin="0,0,0,15"/>
                                        <TextBlock Text="🛏️ 如果你在末地睡觉，床会爆炸，但你可以利用这个特性来快速击杀末影龙。" Foreground="#AAA" TextWrapping="Wrap" Margin="0,0,0,15"/>
                                        <TextBlock Text="🐺 驯服狼只需要喂食骨头，但驯服猫需要喂食生鳕鱼或生鲑鱼。" Foreground="#AAA" TextWrapping="Wrap" Margin="0,0,0,15"/>
                                    </StackPanel>
                                </ScrollViewer>
                            </Grid>
                        </ui:Card>
                    </Grid>

                    <!-- 1. 啟動頁面 -->
                    <Grid x:Name="HomePanel" Visibility="Visible">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="340"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center" MaxWidth="500" HorizontalAlignment="Left">
                            <TextBlock Text="Minecraft" FontSize="64" FontWeight="Black" Foreground="White" Margin="0,0,0,10"/>
                            <TextBlock Text="拖拽 .jar 或 .mrpack 到窗口可直接安裝" FontSize="14" Foreground="#AAA" Margin="0,0,0,20"/>
                            <TextBlock Text="當前遊戲目錄: " Foreground="#AAA" FontSize="12"/>
                            <TextBlock x:Name="CurrentMinecraftDirText" Foreground="#3B82F6" FontSize="13" Margin="0,0,0,30" TextTrimming="CharacterEllipsis"/>
                            
                            <TextBlock Text="选择已安装版本" Foreground="#AAA" Margin="0,0,0,5"/>
                            <Grid Width="340" HorizontalAlignment="Left" Margin="0,0,0,25">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ComboBox x:Name="VersionCombo" Height="45" FontSize="16"/>
                                <ui:Button Grid.Column="1" Icon="{ui:SymbolIcon Settings24}" Margin="10,0,0,0" Height="45" Click="ShowVersionSettings_Click"/>
                            </Grid>
                            <ui:Button Content="启动游戏" Width="220" Height="55" HorizontalAlignment="Left" Appearance="Primary" FontSize="20" Click="Launch_Click"/>
                        </StackPanel>

                        <ui:Card Grid.Column="1" VerticalAlignment="Center" Padding="20" HorizontalAlignment="Right" Background="#EE222222">
                            <StackPanel>
                                <TextBlock Text="当前账号" Foreground="#AAA" FontSize="12"/>
                                <TextBlock x:Name="AccountText" Text="Player (离线)" FontSize="20" FontWeight="Bold" Foreground="White" Margin="0,5,0,20"/>
                                <ui:Button Content="微软正版登录" Appearance="Success" Height="40" Margin="0,0,0,10" Click="Login_Click"/>
                                <ui:Button Content="管理离线账号" Height="40" Margin="0,0,0,10" Click="ShowAccountPage"/>
                                <ui:Button Content="切換遊戲目錄" Icon="{ui:SymbolIcon FolderOpen24}" Height="40" Click="ChangeMinecraftDir_Click"/>
                            </StackPanel>
                        </ui:Card>
                    </Grid>

                    <!-- 2. 版本管理 -->
                    <Grid x:Name="VersionManagerPanel" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid Margin="0,0,0,15">
                            <TextBlock Text="本地版本管理" FontSize="24" FontWeight="Bold" Foreground="White"/>
                            <ui:Button Content="刷新列表" HorizontalAlignment="Right" Click="RefreshVersionManager_Click"/>
                        </Grid>
                        <ScrollViewer Grid.Row="1">
                            <StackPanel x:Name="VersionManagerList"/>
                        </ScrollViewer>
                    </Grid>

                    <!-- 3. 下載中心 -->
                    <Grid x:Name="DownloadPanel" Visibility="Collapsed">
                        <TabControl Background="Transparent" BorderThickness="0">
                            <TabItem Header="原版游戏">
                                <ScrollViewer Margin="0,15,0,0">
                                    <StackPanel x:Name="VanillaListPanel">
                                        <TextBlock Text="正在獲取版本清單..." Foreground="Gray"/>
                                    </StackPanel>
                                </ScrollViewer>
                            </TabItem>
                            <TabItem Header="加載器安裝">
                                <ui:Card Padding="30" Margin="0,15,0,0" Background="#EE222222">
                                    <StackPanel>
                                        <TextBlock Text="安裝 Mod 加載器" FontSize="20" FontWeight="Bold" Foreground="White" Margin="0,0,0,20"/>
                                        <TextBlock Text="選擇基礎原版版本:" Foreground="#AAA" Margin="0,0,0,10"/>
                                        <ComboBox x:Name="LoaderBaseVersionCombo" Width="300" Height="40" HorizontalAlignment="Left" Margin="0,0,0,20"/>
                                        <WrapPanel>
                                            <ui:Button Content="安裝 Fabric" Background="#F59E0B" Foreground="White" Width="140" Height="45" Margin="0,0,15,15" Click="InstallFabric_Click"/>
                                            <ui:Button Content="安裝 Forge" Background="#EF4444" Foreground="White" Width="140" Height="45" Margin="0,0,15,15" Click="InstallForge_Click"/>
                                        </WrapPanel>
                                    </StackPanel>
                                </ui:Card>
                            </TabItem>
                            <TabItem Header="整合包 (Modpack)">
                                <Grid Margin="0,15,0,0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <Grid Margin="0,0,0,15">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <ui:TextBox x:Name="ModpackSearchBox" PlaceholderText="搜索 Modrinth 整合包" Height="40"/>
                                        <ui:Button Grid.Column="1" Content="搜索" Appearance="Primary" Margin="10,0,0,0" Width="100" Height="40" Click="SearchModpacks_Click"/>
                                    </Grid>
                                    <ScrollViewer Grid.Row="1">
                                        <StackPanel x:Name="ModpackListPanel"/>
                                    </ScrollViewer>
                                </Grid>
                            </TabItem>
                        </TabControl>
                    </Grid>

                    <!-- 4. Mod 管理 -->
                    <Grid x:Name="ModManagerPanel" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid Margin="0,0,0,15">
                            <TextBlock Text="已安装 Mod 列表" FontSize="24" FontWeight="Bold" Foreground="White"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <ui:Button Content="導入 Mod" Icon="{ui:SymbolIcon Add24}" Margin="0,0,10,0" Click="ImportMod_Click"/>
                                <ui:Button Content="打开文件夹" Icon="{ui:SymbolIcon Folder24}" Click="OpenModsFolder_Click"/>
                            </StackPanel>
                        </Grid>
                        <ScrollViewer Grid.Row="1">
                            <StackPanel x:Name="InstalledModsPanel"/>
                        </ScrollViewer>
                    </Grid>

                    <!-- 5. Mod 搜尋 -->
                    <Grid x:Name="ModsPanel" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid Margin="0,0,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ui:TextBox x:Name="ModSearchBox" PlaceholderText="搜索 Modrinth 模組" Height="40" FontSize="14"/>
                            <ui:Button Grid.Column="1" Content="搜索" Appearance="Primary" Margin="10,0,0,0" Width="100" Height="40" Click="SearchMods_Click"/>
                        </Grid>
                        <ScrollViewer Grid.Row="1">
                            <StackPanel x:Name="ModListPanel"/>
                        </ScrollViewer>
                    </Grid>

                    <!-- 6. 伺服器狀態 -->
                    <Grid x:Name="ServerPanel" Visibility="Collapsed">
                        <ScrollViewer>
                            <StackPanel MaxWidth="600" HorizontalAlignment="Left">
                                <TextBlock Text="伺服器狀態查詢" FontSize="24" FontWeight="Bold" Foreground="White" Margin="0,0,0,20"/>
                                <ui:Card Padding="20" Margin="0,0,0,15" Background="#EE222222">
                                    <StackPanel>
                                        <TextBlock Text="輸入伺服器 IP (例如 play.hypixel.net)" Foreground="#AAA" Margin="0,0,0,10"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <ui:TextBox x:Name="ServerIpBox" Text="play.hypixel.net" Height="40"/>
                                            <ui:Button Grid.Column="1" Content="查詢" Appearance="Primary" Margin="10,0,0,0" Width="100" Height="40" Click="QueryServer_Click"/>
                                        </Grid>
                                    </StackPanel>
                                </ui:Card>
                                
                                <ui:Card x:Name="ServerResultCard" Padding="20" Background="#EE222222" Visibility="Collapsed">
                                    <StackPanel>
                                        <TextBlock x:Name="ServerStatusText" FontSize="20" FontWeight="Bold" Foreground="White"/>
                                        <TextBlock x:Name="ServerPlayersText" FontSize="16" Foreground="#AAA" Margin="0,10,0,0"/>
                                        <TextBlock x:Name="ServerVersionText" FontSize="14" Foreground="#AAA" Margin="0,5,0,0"/>
                                    </StackPanel>
                                </ui:Card>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <!-- 7. 帳號管理 -->
                    <Grid x:Name="AccountPanel" Visibility="Collapsed">
                        <ScrollViewer>
                            <StackPanel MaxWidth="500" HorizontalAlignment="Left">
                                <TextBlock Text="帳號管理" FontSize="24" FontWeight="Bold" Foreground="White" Margin="0,0,0,20"/>
                                <ui:Card Padding="20" Margin="0,0,0,15" Background="#EE222222">
                                    <StackPanel>
                                        <TextBlock Text="添加離線賬號" FontWeight="Bold" Foreground="White" Margin="0,0,0,10"/>
                                        <ui:TextBox x:Name="NewOfflineNameBox" PlaceholderText="輸入玩家名稱" Height="35" Margin="0,0,0,10"/>
                                        <ui:Button Content="添加並切換" Appearance="Primary" Click="AddOfflineAccount_Click"/>
                                    </StackPanel>
                                </ui:Card>
                                <ui:Card Padding="20" Background="#EE222222">
                                    <StackPanel>
                                        <TextBlock Text="已保存的賬號" FontWeight="Bold" Foreground="White" Margin="0,0,0,10"/>
                                        <StackPanel x:Name="SavedAccountsPanel"/>
                                    </StackPanel>
                                </ui:Card>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <!-- 8. 日誌查看 -->
                    <Grid x:Name="LogPanel" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid Margin="0,0,0,15">
                            <TextBlock Text="最新遊戲日誌 (latest.log)" FontSize="24" FontWeight="Bold" Foreground="White"/>
                            <ui:Button Content="刷新日誌" HorizontalAlignment="Right" Click="RefreshLog_Click"/>
                        </Grid>
                        <ui:Card Grid.Row="1" Padding="10" Background="#EE111111">
                            <ScrollViewer>
                                <TextBlock x:Name="LogTextBox" FontFamily="Consolas" Foreground="#AAA" FontSize="12" TextWrapping="Wrap"/>
                            </ScrollViewer>
                        </ui:Card>
                    </Grid>

                    <!-- 9. 設置頁面 -->
                    <Grid x:Name="SettingsPanel" Visibility="Collapsed">
                        <ScrollViewer>
                            <StackPanel MaxWidth="600" HorizontalAlignment="Left">
                                <TextBlock Text="全局高级设置" FontSize="24" FontWeight="Bold" Foreground="White" Margin="0,0,0,20"/>
                                
                                <ui:Card Padding="20" Margin="0,0,0,15" Background="#EE222222">
                                    <StackPanel>
                                        <TextBlock Text="目录设置" FontSize="16" FontWeight="Bold" Foreground="White" Margin="0,0,0,10"/>
                                        <TextBlock Text="Minecraft 游戏目录" FontSize="12" Foreground="Gray" Margin="0,0,0,5"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <ui:TextBox x:Name="MinecraftDirBox" Height="35" Margin="0,0,10,0" IsReadOnly="True"/>
                                            <ui:Button Grid.Column="1" Content="选择目录" Click="ChangeMinecraftDir_Click"/>
                                        </Grid>
                                    </StackPanel>
                                </ui:Card>

                                <ui:Card Padding="20" Margin="0,0,0,15" Background="#EE222222">
                                    <StackPanel>
                                        <TextBlock Text="内存与 Java" FontSize="16" FontWeight="Bold" Foreground="White" Margin="0,0,0,10"/>
                                        
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="最大内存 (MB)" FontSize="12" Foreground="Gray" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="MemoryTextDisplay" Text="4096" FontSize="14" FontWeight="Bold" Foreground="White" Grid.Column="1" VerticalAlignment="Center"/>
                                        </Grid>
                                        <Slider x:Name="MemorySlider" Minimum="2048" Maximum="16384" Value="4096" TickFrequency="1024" IsSnapToTickEnabled="True" Margin="0,5,0,10" ValueChanged="MemorySlider_ValueChanged"/>
                                        
                                        <TextBlock Text="Java 路徑 (留空自動尋找)" FontSize="12" Foreground="Gray" Margin="0,10,0,5"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <ui:TextBox x:Name="JavaPathBox" Height="35" Margin="0,0,10,0"/>
                                            <ui:Button Grid.Column="1" Content="掃描 Java" Click="ScanJava_Click"/>
                                        </Grid>
                                        <ui:Button Content="我沒有 Java 21，點我下載" Appearance="Caution" Margin="0,10,0,0" Click="DownloadJava_Click"/>
                                    </StackPanel>
                                </ui:Card>

                                <ui:Card Padding="20" Margin="0,0,0,15" Background="#EE222222">
                                    <StackPanel>
                                        <TextBlock Text="下載與外觀" FontSize="16" FontWeight="Bold" Foreground="White" Margin="0,0,0,10"/>
                                        <ui:Button Content="更換壁紙" Width="120" Click="ChangeWallpaper_Click"/>
                                    </StackPanel>
                                </ui:Card>

                                <ui:Card Padding="20" Margin="0,0,0,15" Background="#EE222222">
                                    <StackPanel>
                                        <TextBlock Text="游戏行为" FontSize="16" FontWeight="Bold" Foreground="White" Margin="0,0,0,10"/>
                                        <CheckBox x:Name="DiscordRpcCheck" Content="啟用 Discord 狀態" Foreground="White" Margin="0,5" IsChecked="True"/>
                                        <CheckBox x:Name="FullScreenCheck" Content="啟動時全螢幕" Foreground="White" Margin="0,5"/>
                                        <CheckBox x:Name="VersionIsolationCheck" Content="啟用版本隔離" Foreground="White" Margin="0,5" IsChecked="True"/>
                                    </StackPanel>
                                </ui:Card>

                                <ui:Button Content="保存设置" Appearance="Primary" Width="150" Height="40" Margin="0,10,0,20" Click="SaveSettings_Click"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Grid>

                <!-- 底部狀態列 -->
                <Border Grid.Row="2" Background="#EE111111" BorderBrush="#333" BorderThickness="0,1,0,0">
                    <Grid Margin="20,0">
                        <TextBlock x:Name="StatusText" Text="准备就绪" Foreground="#AAA" FontSize="12" VerticalAlignment="Center"/>
                        <ProgressBar x:Name="DownloadProgress" Height="4" Width="200" HorizontalAlignment="Right" VerticalAlignment="Center" Value="0" Maximum="100"/>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</ui:FluentWindow>